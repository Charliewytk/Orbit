// Copy this file to Config/Secrets.xcconfig and fill in your own values.
// Secrets.xcconfig is git-ignored. See docs/SETUP.md for where each value comes from.
//
// Note: in .xcconfig files "//" starts a comment, so never paste a full URL here.

// Google Cloud → APIs & Services → Credentials → your iOS OAuth client:
// "Client ID", e.g. 123456789012-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID = YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

// The same client's "iOS URL scheme", e.g. com.googleusercontent.apps.123456789012-abcdefg
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_GOOGLE_CLIENT_ID

// entra.microsoft.com → App registrations → Orbit → "Application (client) ID"
MICROSOFT_CLIENT_ID = 00000000-0000-0000-0000-000000000000

// Optional: override your Apple Team ID here instead of in Orbit.xcconfig.
// DEVELOPMENT_TEAM = ABCDE12345
