// Orbit build settings, shared by every target.
//
// 1. Set DEVELOPMENT_TEAM to your 10-character Apple Team ID
//    (Xcode → Settings → Accounts → your team, or developer.apple.com → Membership).
// 2. Put your OAuth client IDs in Config/Secrets.xcconfig (copy Secrets.example.xcconfig).
//    That file is git-ignored, so your IDs never end up in the repo.

ORBIT_BUNDLE_PREFIX = com.charliewytk
DEVELOPMENT_TEAM =
MARKETING_VERSION = 0.1.0

// iCloud sync container. The free unsigned download build blanks this, so the
// app stores everything locally on the Mac instead.
ORBIT_ICLOUD_CONTAINER = iCloud.$(ORBIT_BUNDLE_PREFIX).orbit
CURRENT_PROJECT_VERSION = 1

// Google iOS OAuth client (project gen-lang-client-0630020611). iOS-type
// client IDs aren't secret: Google ships them inside apps, so it's fine here.
GOOGLE_CLIENT_ID = 847336970377-bl2444batr4n09gg0anb4pfhhtqj44n7.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.847336970377-bl2444batr4n09gg0anb4pfhhtqj44n7

// Filled in once the Microsoft app is registered. Sign-in explains what's missing until then.
MICROSOFT_CLIENT_ID =

#include? "Secrets.xcconfig"
